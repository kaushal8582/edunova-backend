{
  "name": "backend",
  "version": "1.0.0",
  "description": "EduNova education platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:super-admin": "tsx src/scripts/seed-super-admin.ts"
  },
  "author": "",
  "license": "ISC",
