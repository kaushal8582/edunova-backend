    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fast-xml-parser": "^5.12.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mongoose": "^9.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
