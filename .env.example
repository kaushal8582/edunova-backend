NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/edunova
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=refreshToken
CSRF_COOKIE_NAME=csrfToken

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EduNova <noreply@example.com>"

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

EMAIL_VERIFICATION_OTP_TTL_SECONDS=900
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=3600

# Object storage: local | s3 | r2
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.storage
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_URL_EXPIRES_SECONDS=900
STORAGE_READ_URL_EXPIRES_SECONDS=300
MAX_PDF_BYTES=104857600
MAX_EPUB_BYTES=52428800
MAX_COVER_BYTES=5242880
REQUIRE_COVER_TO_PUBLISH=false
REQUIRE_CHAPTER_APPROVAL_TO_PUBLISH=true
OCR_PROVIDER=none
DISABLE_BOOK_QUEUE=false

# Seed script only (never commit real values)
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=
